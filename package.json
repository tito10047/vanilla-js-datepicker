{
  "name": "@tito10047/vanilla-js-datepicker",
  "version": "0.1.1",
  "description": "Lightweight vanilla JavaScript datepicker with no dependencies",
  "author": "tito10047",
  "license": "MIT",
  "keywords": [
    "datepicker",
    "date",
    "picker",
    "calendar",
    "vanilla",
    "javascript",
    "typescript"
  ],
  "main": "dist/datepicker.cjs.js",
  "module": "dist/datepicker.esm.js",
  "browser": "dist/datepicker.umd.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/datepicker.esm.js",
      "require": "./dist/datepicker.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/datepicker.css": "./dist/datepicker.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript && npm run build:types",
    "build:watch": "rollup -c rollup.config.ts --configPlugin typescript --watch",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/datepicker.esm.js",
      "limit": "20 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^16.0.0",
    "postcss": "^8.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.0",
    "size-limit": "^11.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.0",
    "vitest": "^3.0.0"
  },
  "type": "module"
}
